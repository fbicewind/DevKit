{
  "name": "devkit",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "tauri",
    "test": "vitest run",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --no-default-features",
    "test:e2e": "playwright test",
    "bench:json": "cargo test --release --manifest-path src-tauri/Cargo.toml --no-default-features benchmark_30_mib -- --ignored --nocapture",
    "format": "prettier --write src tests *.ts *.json README.md",
    "check": "npm run build && npm test && npm run test:e2e"
  },
  "dependencies": {
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/language": "6.12.1",
    "@codemirror/state": "6.5.2",
    "@codemirror/view": "6.38.6",
    "@lezer/highlight": "1.2.3",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-clipboard-manager": "2.3.2",
    "@tauri-apps/plugin-dialog": "2.6.0",
    "codemirror": "6.0.2",
    "lucide-react": "0.468.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@tailwindcss/vite": "4.1.17",
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "22.18.12",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.0.4",
    "prettier": "3.6.2",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  }
}
